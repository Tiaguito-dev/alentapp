# ==========================================
# Stage 1: deps
# Propósito: Instalar dependencias
# ==========================================
FROM node:22-alpine AS deps
WORKDIR /app

# Copiamos la estructura del monorepo
COPY package*.json ./
COPY packages/web/package.json ./packages/web/
COPY packages/shared/package.json ./packages/shared/

# Instalamos usando 'ci' para que sea exacto al package-lock y omitimos dependencias de desarrollo globales si es posible
RUN npm ci

# ==========================================
# Stage 2: build
# Propósito: Build de Vite
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

# Copiamos los node_modules de la etapa anterior
COPY --from=deps /app/node_modules ./node_modules
# Copiamos todo el código fuente
COPY . .

# Ejecutamos el build productivo del workspace de web
RUN npm run build -w packages/web

# ==========================================
# Stage 3: runtime
# Propósito: Servir archivos estáticos con nginx
# ==========================================
FROM nginx:stable-alpine AS runtime

# Eliminamos la configuración por defecto de nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiamos nuestra configuración optimizada
COPY packages/web/nginx.conf /etc/nginx/conf.d/

# Copiamos los estáticos generados en la etapa de build
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Healthcheck requerido por la cátedra
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:80/ || exit 1
  
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]