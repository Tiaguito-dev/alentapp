{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "RED — Alentapp API",
  "uid": "red-alentapp-api",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "title": "1. Requests por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_server_duration_count[1m])",
          "legendFormat": "Requests / seg",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "2. Tasa de error (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_count{http_status_code=~\"4..|5..\"}[1m])) / sum(rate(http_server_duration_count[1m])) * 100",
          "legendFormat": "% errores",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "3. Latencia p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "4. Por status code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (http_status_code) (rate(http_server_duration_count[5m]))",
          "legendFormat": "HTTP {{http_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "5. Memoria del proceso",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        }
      },
      "targets": [
        {
          "expr": "process_memory_usage / 1024 / 1024",
          "legendFormat": "MB usados",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "6. Endpoints más lentos (top 5)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus" },
      "options": { "orientation": "horizontal" },
      "targets": [
        {
          "expr": "topk(5, avg by (http_route) (rate(http_server_duration_sum[5m]) / rate(http_server_duration_count[5m])))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    }
  ]
}